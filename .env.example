# ============================================================
# ARAS BACKEND — Environment Variables
# ============================================================
# CARA PAKAI:
#   cp .env.example .env
#   nano .env  → isi semua yang masih kosong
#
# PERINGATAN: Jangan pernah commit file .env ke GitHub!
# Pastikan .gitignore sudah ada baris: .env
# ============================================================

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_NAME=ARAS
APP_URL=https://api-aras.example.com
WEB_URL=https://aras.example.com

# ------------------------------------------------------------
# DATABASE MySQL 8.0 — di Docker Container
#
# MySQL berjalan di Docker dengan konfigurasi:
#   Container IP : 172.18.0.2  (di platform-network)
#   Port         : 3306
#   Root user    : root / Bandulan112
#
# Backend ARAS dijalankan via PM2 di HOST (bukan di Docker),
# sehingga untuk akses ke MySQL container gunakan IP container.
#
# JANGAN pakai 'localhost' atau '127.0.0.1' karena itu
# menunjuk ke host, bukan ke container Docker.
# ------------------------------------------------------------
DB_HOST=172.18.0.2
DB_PORT=3306
DB_NAME=aras_db
DB_USER=aras_user
DB_PASS=                        # TODO: isi password user aras_user
DB_POOL_MIN=2
DB_POOL_MAX=20

# ------------------------------------------------------------
# REDIS — Install di HOST (bukan Docker)
#
# Redis dipasang langsung di host (bukan container) supaya
# mudah diakses dari PM2 tanpa perlu bridging Docker network.
# Cara install: lihat INSTALL_VPS.md bagian "Setup Redis"
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=                     # TODO: isi setelah set requirepass di redis.conf
REDIS_URL=redis://:ISI_REDIS_PASS_DISINI@127.0.0.1:6379

# TTL Cache dalam detik
REDIS_TTL_STATIS=3600           # 1 jam  → spesialisasi, badge, paket
REDIS_TTL_SEMI=900              # 15 mnt → profil dokter, artikel populer
REDIS_TTL_SESI=86400            # 24 jam → refresh token, status online

# ------------------------------------------------------------
# JWT & SECURITY
# Generate secret (jalankan 3x, hasil berbeda tiap kali):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=                     # TODO: string acak 64+ karakter
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=             # TODO: string acak 64+ karakter (BERBEDA dari JWT_SECRET)
JWT_REFRESH_EXPIRES_IN=30d
OTP_SECRET=                     # TODO: string acak 32+ karakter
OTP_EXPIRES_IN=300              # 5 menit dalam detik

BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------
# CLOUDINARY (Storage foto & dokumen)
# Daftar gratis di: https://cloudinary.com
# Setelah daftar: Dashboard → Settings → API Keys
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=          # TODO: isi Cloud Name dari dashboard
CLOUDINARY_API_KEY=             # TODO: isi API Key dari dashboard
CLOUDINARY_API_SECRET=          # TODO: isi API Secret dari dashboard
CLOUDINARY_FOLDER=aras

# ------------------------------------------------------------
# FIREBASE (Push Notification FCM)
# Firebase Console → Project Settings → Service Accounts
# → "Generate New Private Key" → simpan sebagai firebase-service-account.json
# → taruh file itu di root folder backend
# ------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=            # TODO: dari Firebase Console → Project Settings

# ------------------------------------------------------------
# EMAIL (Nodemailer via Gmail App Password)
# Cara dapat App Password Gmail:
#   1. Aktifkan 2-Step Verification di akun Google
#   2. myaccount.google.com → Security → App Passwords
#   3. Pilih "Mail" → "Other (Custom name)" → ketik "ARAS"
#   4. Google akan kasih password 16 karakter
#   5. Masukkan 16 karakter itu ke SMTP_PASS (tanpa spasi)
# JANGAN pakai password Gmail biasa, tidak akan work!
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                      # TODO: email Gmail Anda (contoh: nama@gmail.com)
SMTP_PASS=                      # TODO: App Password 16 karakter (contoh: abcdabcdabcdabcd)
EMAIL_FROM=ARAS Support <no-reply@example.com>

# ------------------------------------------------------------
# WHATSAPP OTP (Fonnte)
# Daftar di: https://fonnte.com (ada free tier)
# Setelah daftar dan connect WA: Dashboard → Devices → Token
# ------------------------------------------------------------
FONNTE_TOKEN=                   # TODO: token dari dashboard Fonnte
FONNTE_SENDER=                  # TODO: nomor WA (format: 628xxxxxxxxxx)

# ------------------------------------------------------------
# JITSI MEET (Video Call)
# Sementara pakai server publik Jitsi — gratis, tidak perlu install
# Bisa self-host nanti jika traffic sudah besar
# ------------------------------------------------------------
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=aras
JITSI_APP_SECRET=               # TODO: generate random string

# ------------------------------------------------------------
# EXTERNAL API (semuanya gratis)
# ------------------------------------------------------------

BPOM_API_URL=https://api-meso.pom.go.id

OPENFDA_API_URL=https://api.fda.gov
OPENFDA_API_KEY=                # Opsional (tanpa key = 1000 req/hari)

OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v2
OPENFOODFACTS_USER_AGENT=ARAS/1.0 (kontak@example.com)

NOMINATIM_API_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=kontak@example.com   # WAJIB diisi — syarat ToS Nominatim

OVERPASS_API_URL=https://overpass-api.de/api/interpreter

RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST

MEDLINEPLUS_API_URL=https://wsearch.nlm.nih.gov/ws/query

# ------------------------------------------------------------
# SOCKET.IO
# ------------------------------------------------------------
SOCKET_CORS_ORIGIN=https://aras.example.com
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# ------------------------------------------------------------
# UPLOAD
# ------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,webp

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://aras.example.com,https://api-aras.example.com

# ------------------------------------------------------------
# LOG
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_ERROR=./logs/error.log
LOG_FILE_COMBINED=./logs/combined.log

# ------------------------------------------------------------
# PAYMENT GATEWAY — Aktifkan di Fase 9
# ------------------------------------------------------------
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
